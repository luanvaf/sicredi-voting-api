# Copy this file to .env for local Docker Compose use.
# Set the blank password fields locally and never commit the populated .env file.

APP_PORT=8080
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_DB=voting
POSTGRES_USER=voting
POSTGRES_PASSWORD=

RABBITMQ_USERNAME=voting
RABBITMQ_PASSWORD=

DATABASE_MAXIMUM_POOL_SIZE=10
DATABASE_MINIMUM_IDLE=2

# Hosted values are set in the Render dashboard, not in a committed file.
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=
RABBITMQ_URL=
ELIGIBILITY_BASE_URL=
